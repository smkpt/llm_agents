# ==============================================================================
# Enterprise AI Gateway Environment Configuration
# ==============================================================================

# --- Primary Provider: Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-small

# --- Secondary / Fallback Providers ---
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...

# --- Local / Air-Gapped Private Inference (Ollama / vLLM) ---
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b

# --- Gateway Runtime Flags ---
USE_MOCK_FALLBACK=true
ENABLE_SEMANTIC_CACHE=true
CACHE_TTL_SECONDS=3600
DEFAULT_TIMEOUT_SECONDS=30
